{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // Shared control-plane code still references Cloudflare globals — R2Bucket
    // (blobstore/r2.ts), Hyperdrive and DurableObjectNamespace (config.ts Env,
    // the DurableObjectActivator forwarder), FixedLengthStream — so their types
    // come from @cloudflare/workers-types alongside node. skipLibCheck (base)
    // keeps the two global sets from colliding in their own .d.ts files.
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["src"]
}

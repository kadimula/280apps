digraph EgressArchitecture {
  graph [
    rankdir=LR
    bgcolor="#080A09"
    pad="0.45"
    nodesep="0.42"
    ranksep="0.82"
    splines=polyline
    newrank=true
    outputorder=edgesfirst
    fontname="Arial"
    fontcolor="#F5F2EA"
    label=<<B>Egress architecture</B>>
    labelloc=t
    labeljust=l
    fontsize=28
  ]

  node [
    shape=rect
    style="rounded,filled"
    margin="0.22,0.16"
    fontname="Arial"
    fontsize=12
    color="#454842"
    fontcolor="#F5F2EA"
    fillcolor="#151816"
    penwidth=1.4
  ]

  edge [
    fontname="Arial"
    fontsize=10
    fontcolor="#CAC7BF"
    color="#D7D4CC"
    arrowsize=0.72
    penwidth=1.35
  ]

  app [
    label=<<B>Application process</B><BR/><FONT POINT-SIZE="10">Sends a plain request without platform credentials</FONT>>
    fillcolor="#17251A"
    color="#70A87B"
  ]
  policy [
    label=<<B>Effective egress policy</B><BR/><FONT POINT-SIZE="10">Allowed hosts and credential names</FONT>>
    shape=note
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  gate [
    label=<<B>Container proxy host gate</B><BR/><FONT POINT-SIZE="10">Default deny, HTTP 520 when blocked</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  handler [
    label=<<B>Outbound handler</B><BR/><FONT POINT-SIZE="10">Resolve, attach, forward, and record</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  minter [
    label=<<B>Closed minter registry</B><BR/><FONT POINT-SIZE="10">Static header or scoped Google token</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  vault [
    label=<<B>Worker side vault</B><BR/><FONT POINT-SIZE="10">Secret values never enter the container</FONT>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  token [
    label=<<B>Google token endpoint</B><BR/><FONT POINT-SIZE="10">Assertion exchange for typed credentials</FONT>>
    shape=oval
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  upstream [
    label=<<B>Allowed upstream API</B><BR/><FONT POINT-SIZE="10">Receives the injected credential</FONT>>
    shape=oval
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  audit [
    label=<<B>Audit sink</B><BR/><FONT POINT-SIZE="10">Value free request and mint events</FONT>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]

  legend [
    shape=plain
    margin=0
    label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#454842" BGCOLOR="#101210">
      <TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legend</B></TD></TR>
      <TR><TD BGCOLOR="#17251A" BORDER="1" COLOR="#70A87B" WIDTH="24"></TD><TD ALIGN="LEFT">Application runtime</TD></TR>
      <TR><TD BGCOLOR="#28172A" BORDER="1" COLOR="#B56BAA"></TD><TD ALIGN="LEFT">Egress enforcement</TD></TR>
      <TR><TD BGCOLOR="#12232C" BORDER="1" COLOR="#65A9D0"></TD><TD ALIGN="LEFT">Platform data and external services</TD></TR>
      <TR><TD BORDER="1" COLOR="#426C84"></TD><TD ALIGN="LEFT">Outlined areas are runtime boundaries</TD></TR>
    </TABLE>>
  ]

  subgraph cluster_container {
    label="Application container sandbox"
    style="rounded,filled"
    color="#426C84"
    fillcolor="#121412"
    fontcolor="#65A9D0"
    fontsize=11
    penwidth=1.1
    margin=18
    app
  }

  subgraph cluster_worker {
    label="Per application Worker and Cloudflare container runtime"
    style="rounded,filled"
    color="#426C84"
    fillcolor="#121412"
    fontcolor="#65A9D0"
    fontsize=11
    penwidth=1.1
    margin=18
    policy
    gate
    handler
    minter
  }

  { rank=same; app; legend }
  { rank=same; policy; gate }
  { rank=same; handler; vault }
  { rank=same; minter; audit }
  { rank=same; token; upstream }

  app -> gate [label="Plain HTTPS request", color="#70A87B", fontcolor="#70A87B"]
  policy -> gate [label="Allowed hosts", color="#65A9D0", fontcolor="#65A9D0"]
  policy -> handler [label="Host config and secret name", color="#65A9D0", fontcolor="#65A9D0"]
  gate -> app [label="520 when blocked", color="#D8AA35", fontcolor="#D8AA35", constraint=false]
  gate -> handler [label="Admitted request", color="#B56BAA", fontcolor="#B56BAA"]
  vault -> handler [label="Value at call time", color="#65A9D0", fontcolor="#65A9D0"]
  handler -> minter [label="Credential input", color="#B56BAA", fontcolor="#B56BAA"]
  minter -> handler [label="Header and value", color="#B56BAA", fontcolor="#B56BAA", constraint=false]
  minter -> token [dir=both, label="Assertion for access token"]
  handler -> upstream [label="Forward with credential"]
  upstream -> handler [label="Response", constraint=false]
  handler -> audit [label="Request outcome"]
  minter -> audit [label="Mint outcome"]
  handler -> app [label="Upstream response", color="#70A87B", fontcolor="#70A87B", constraint=false]

  app -> legend [style=invis, weight=10]
  handler -> vault [style=invis, weight=10]
  token -> upstream [style=invis, weight=10]
}

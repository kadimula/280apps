digraph Architecture {
  graph [
    rankdir=TB,
    bgcolor="#070707",
    pad="0.45",
    nodesep="0.48",
    ranksep="1.0",
    splines=ortho,
    compound=true,
    fontname="Arial",
    fontcolor="#F4F0E8",
    label="280apps architecture  |  deploy, identity, and request flow",
    labelloc=t,
    labeljust=l,
    fontsize=25
  ];

  node [
    shape=rect,
    style="rounded,filled",
    margin="0.18,0.13",
    fontname="Arial",
    fontsize=11,
    color="#4A4740",
    fontcolor="#F4F0E8",
    fillcolor="#141414",
    penwidth=1.2
  ];

  edge [
    fontname="Arial",
    fontsize=9,
    fontcolor="#D9D3C7",
    color="#DED7C9",
    arrowsize=0.75,
    penwidth=1.3
  ];

  agent [label="Coding agent or builder", shape=oval, fillcolor="#211B0D", color="#D6AD45"];
  operator [label="App owner or admin", shape=oval, fillcolor="#211B0D", color="#D6AD45"];
  viewer [label="App viewer", shape=oval, fillcolor="#211B0D", color="#D6AD45"];
  provider [label="Google or Microsoft OIDC", shape=oval, fillcolor="#111A20", color="#5B91B5"];
  upstream [label="Approved external APIs", shape=oval, fillcolor="#111A20", color="#5B91B5"];

  subgraph cluster_interfaces {
    label="Developer and operator interfaces";
    color="#33302A";
    fontcolor="#CFC7B8";
    style="rounded";
    margin=20;

    cli [
      label="packages/cli\ntwo80 command line\nbundle, upload, poll",
      URL="../packages/cli/",
      fillcolor="#241E10",
      color="#D6AD45"
    ];
    dashboard [
      label="packages/dashboard\nNext.js management UI\napps, sharing, secrets, preview",
      URL="../packages/dashboard/",
      fillcolor="#241E10",
      color="#D6AD45"
    ];
  }

  subgraph cluster_control {
    label="Control plane";
    color="#33302A";
    fontcolor="#CFC7B8";
    style="rounded";
    margin=20;

    backend [
      label="packages/backend\nRailway Node service\ndeploy, auth, policy, storage",
      URL="../packages/backend/",
      fillcolor="#182118",
      color="#74A574"
    ];
    postgres [label="PostgreSQL\nusers, sessions, grants, deploys", shape=cylinder, fillcolor="#111A20", color="#5B91B5"];
    r2 [label="Cloudflare R2\nuploaded build blobs", shape=cylinder, fillcolor="#111A20", color="#5B91B5"];
    depot [label="Depot\nremote BuildKit", fillcolor="#111A20", color="#5B91B5"];
    registry [label="Cloudflare container registry\nper app images", shape=cylinder, fillcolor="#111A20", color="#5B91B5"];
  }

  subgraph cluster_identity {
    label="Central identity plane";
    color="#33302A";
    fontcolor="#CFC7B8";
    style="rounded";
    margin=20;

    gateway [
      label="packages/gateway\ncentral identity authority\nsession, admission, token minting",
      URL="../packages/gateway/",
      fillcolor="#211720",
      color="#A66A9A"
    ];
  }

  subgraph cluster_app {
    label="One isolated deployment per app";
    color="#33302A";
    fontcolor="#CFC7B8";
    style="rounded";
    margin=20;

    appworker [
      label="Per app Cloudflare Worker\ngateway middleware\nlocal token verification and route gates",
      fillcolor="#211720",
      color="#A66A9A"
    ];
    appcontainer [
      label="platform/appcontainer\nCloudflare Container harness\nruns the unchanged app image",
      URL="../platform/appcontainer/",
      fillcolor="#182118",
      color="#74A574"
    ];
    sdk [
      label="packages/sdk\nidentity(), can(), scope()\noffline header verification",
      URL="../packages/sdk/",
      fillcolor="#182118",
      color="#74A574"
    ];
    egress [
      label="packages/egress\ndefault deny outbound boundary\ncredential injection and call log",
      URL="../packages/egress/",
      fillcolor="#182118",
      color="#74A574"
    ];
  }

  contracts [
    label="packages/contracts\nshared API schemas, policy, identity signing and verification",
    URL="../packages/contracts/",
    fillcolor="#24201B",
    color="#B6A68B"
  ];

  agent -> cli [label="two80 push", color="#D6AD45", fontcolor="#D6AD45"];
  operator -> dashboard [label="HTTPS", color="#D6AD45", fontcolor="#D6AD45"];
  cli -> backend [label="sync, blobs, status", color="#D6AD45", fontcolor="#D6AD45"];
  dashboard -> backend [label="session API", color="#D6AD45", fontcolor="#D6AD45"];

  backend -> postgres [label="state and policy", color="#D6AD45", fontcolor="#D6AD45"];
  backend -> r2 [label="store build blobs", color="#D6AD45", fontcolor="#D6AD45"];
  backend -> depot [label="build context", color="#D6AD45", fontcolor="#D6AD45"];
  depot -> registry [label="push image", color="#D6AD45", fontcolor="#D6AD45"];
  backend -> appworker [label="wrangler deploy and rollout", color="#D6AD45", fontcolor="#D6AD45"];
  registry -> appcontainer [label="pull app image", color="#D6AD45", fontcolor="#D6AD45"];

  viewer -> appworker [label="HTTPS request"];
  appworker -> gateway [label="service binding\nmint or refresh, JWKS"];
  gateway -> postgres [label="session, grants, audit"];
  gateway -> provider [label="central login"];
  appworker -> appcontainer [label="X 280 Identity"];
  appcontainer -> sdk [label="app reads verified identity"];
  appcontainer -> egress [label="outbound request"];
  egress -> upstream [label="allowlisted request\ncredential attached"];

  cli -> contracts [style=dashed, color="#77736B", fontcolor="#A9A399", label="uses"];
  backend -> contracts [style=dashed, color="#77736B", fontcolor="#A9A399", label="uses"];
  gateway -> contracts [style=dashed, color="#77736B", fontcolor="#A9A399", label="uses"];
  sdk -> contracts [style=dashed, color="#77736B", fontcolor="#A9A399", label="uses"];
  egress -> contracts [style=dashed, color="#77736B", fontcolor="#A9A399", label="uses"];

}

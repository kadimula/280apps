{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "280-gateway-development",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": { "enabled": true },
	"placement": { "mode": "smart" },

	// Container-only serving: the gateway is now the identity mint/JWKS service, not
	// an app proxy. It owns ONLY the auth host; each app is its own Worker on its own
	// <script>-development.280apps.run/* route (emitted by the roll) that calls this
	// gateway's GatewayRPC over a service binding. The legacy dispatch wildcard was
	// removed in the Phase 3 cutover.
	"routes": [{ "pattern": "auth-development.280apps.run/*", "zone_name": "280apps.run" }],

	// The dev Hyperdrive config over the dev control-plane PostgreSQL database (the
	// same database the Node control plane reaches directly via DATABASE_URL). Only
	// this Worker needs Hyperdrive; app Workers never touch the DB.
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "a32cfdb1e2334b2b9d9cc2a2753b832e" }],

	// Secrets via `wrangler secret put`: GOOGLE_OIDC_CLIENT_ID,
	// GOOGLE_OIDC_CLIENT_SECRET, MICROSOFT_ENTRA_OIDC_CLIENT_ID,
	// MICROSOFT_ENTRA_OIDC_CLIENT_SECRET, IDENTITY_SIGNING_PRIVATE_JWK.
	"vars": {
		"DEPLOYMENT_ENVIRONMENT": "development",
		"PLATFORM_DOMAIN": "280apps.com",
		"APP_SERVING_DOMAIN": "280apps.run"
	}
}

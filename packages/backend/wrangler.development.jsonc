{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "280-backend-development",
	// See wrangler.jsonc for why src/worker.ts need not exist yet.
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": ["nodejs_compat"],
	// Development is served over the free *.workers.dev URL for now. The custom
	// api-development.280apps.com route is deferred until 280apps.com is a
	// Cloudflare zone on this account (today it is only 280apps.run); the route
	// block below is intentionally omitted until then. See TWO80_API_ORIGIN.
	"workers_dev": true,
	"observability": { "enabled": true },

	"placement": { "mode": "smart" },

	// Separate dev bucket / Hyperdrive config so development never touches prod
	// blobs or shares a connection pool. Both created by scripts/bootstrap-resources.sh.
	"r2_buckets": [{ "binding": "BLOBS", "bucket_name": "two80-blobs-development" }],

	// Hyperdrive config for development, ALSO created with query caching DISABLED
	// (the same read-your-writes requirement holds in every environment). The id
	// is printed by scripts/bootstrap-resources.sh.
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "ee5bd4e10e12434ca2e1162fbbf97c34" }],

	"durable_objects": {
		"bindings": [{ "name": "APP_ACTIVATOR", "class_name": "AppActivator" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppActivator"] }],

	"triggers": { "crons": ["0 3 * * *"] },

	// Secrets are set per environment with `wrangler secret put ... --env` / against
	// this named worker (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CF_ACCOUNT_ID,
	// CF_API_TOKEN, DATABASE_URL) — never committed here. See wrangler.jsonc.
	"vars": {
		"TWO80_RUNTIME": "cloudflare",
		"TWO80_LOG_FORMAT": "json",
		"TWO80_DB_SCHEMA": "platform",
		"TWO80_APP_DOMAIN": "280apps.run",
		// Development apps serve at <script>-development.280apps.run; the suffix
		// turns on the dispatcher's suffix stripping (see the dispatcher dev config).
		"TWO80_APP_HOST_SUFFIX": "-development",
		// Served over the free *.workers.dev URL until 280apps.com is a Cloudflare
		// zone and the api-development.280apps.com route can attach.
		"TWO80_API_ORIGIN": "https://280-backend-development.kishora1997.workers.dev",
		"TWO80_FRONTEND_ORIGIN": "https://www-development.280apps.com",
		"TWO80_VERIFICATION_URI": "https://280apps.com/activate",
		"TWO80_COOKIE_DOMAIN": ".280apps.com",
		"CF_DISPATCH_NAMESPACE": "apps-development",
		"CF_ISR_CACHE_KV": ""
	}
}

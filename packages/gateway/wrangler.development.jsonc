{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "280-gateway-development",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": { "enabled": true },
	"placement": { "mode": "smart" },

	// Container-only serving: the gateway is now the identity mint/JWKS service, not
	// an app proxy. It owns ONLY the auth host; each app is its own Worker on its own
	// <script>-development.280apps.run/* route (emitted by the roll) that calls this
	// gateway's GatewayRPC over a service binding. The legacy dispatch wildcard was
	// removed in the Phase 3 cutover.
	"routes": [{ "pattern": "auth-development.280apps.run/*", "zone_name": "280apps.run" }],

	// The dev Hyperdrive config over the dev control-plane Postgres (the same Neon DB
	// the Node control plane reaches directly via DATABASE_URL). Only this Worker
	// needs Hyperdrive; app Workers never touch the DB.
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "a32cfdb1e2334b2b9d9cc2a2753b832e" }],

	// Secrets via `wrangler secret put --env development` (or the plain form when
	// deploying this config): GOOGLE_*, ENTRA_*, ID_SIGNING_JWK.
	"vars": {
		"TWO80_DB_SCHEMA": "platform",
		"TWO80_APP_DOMAIN": "280apps.run",
		"TWO80_APP_HOST_SUFFIX": "-development",
		"TWO80_AUTH_HOST": "auth-development.280apps.run",
		"TWO80_COOKIE_DOMAIN": ".280apps.run",
		"TWO80_ID_ISSUER": "https://auth-development.280apps.run",
		"TWO80_ID_TTL_SECS": "30",
		"TWO80_ID_SIGNING_KID": "k1",
		"TWO80_ENTRA_TENANT": "organizations",
		"TWO80_FALLBACK_REDIRECT": "https://280apps.com"
	}
}

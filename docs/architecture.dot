digraph Architecture {
  graph [
    rankdir=TB
    bgcolor="#080A09"
    pad="0.45"
    nodesep="0.38"
    ranksep="0.78"
    splines=polyline
    newrank=true
    outputorder=edgesfirst
    fontname="Arial"
    fontcolor="#F5F2EA"
    label=<<B>280apps architecture</B>>
    labelloc=t
    labeljust=l
    fontsize=28
  ]

  node [
    shape=rect
    style="rounded,filled"
    margin="0.22,0.16"
    fontname="Arial"
    fontsize=12
    color="#454842"
    fontcolor="#F5F2EA"
    fillcolor="#151816"
    penwidth=1.4
  ]

  edge [
    fontname="Arial"
    fontsize=10
    fontcolor="#CAC7BF"
    color="#D7D4CC"
    arrowsize=0.72
    penwidth=1.35
  ]

  actor [
    label=<<B>App owner - Coding Agent</B>>
    shape=oval
    fillcolor="#28210F"
    color="#D8AA35"
  ]

  cli [
    label=<<B>CLI</B>>
    URL="../packages/cli/"
    fillcolor="#28210F"
    color="#D8AA35"
  ]
  dashboard [
    label=<<B>Web Dashboard</B>>
    URL="../packages/dashboard/"
    fillcolor="#28210F"
    color="#D8AA35"
  ]

  backend [
    label=<<B>Backend</B>>
    URL="../packages/backend/"
    fillcolor="#17251A"
    color="#70A87B"
    group="build"
  ]
  postgres [
    label=<<B>Postgres</B>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  r2 [
    label=<<B>Cloudflare R2</B><BR/><FONT POINT-SIZE="10">Uploaded build blobs</FONT>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]

  depot [
    label=<<B>Depot</B><BR/><FONT POINT-SIZE="10">Remote BuildKit</FONT>>
    fillcolor="#12232C"
    color="#65A9D0"
    group="build"
  ]
  registry [
    label=<<B>Container Image registry</B>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  viewer [
    label="App viewer"
    shape=oval
    fillcolor="#28210F"
    color="#D8AA35"
  ]
  worker [
    label=<<B>Per app Worker</B><BR/><FONT POINT-SIZE="10">Identity checks and route gates</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
    group="app-runtime"
  ]
  gateway [
    label=<<B>Identity gateway</B><BR/><FONT POINT-SIZE="10">Session, admission, and token minting</FONT>>
    URL="../packages/gateway/"
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  oidc [
    label="Google or Microsoft OIDC"
    shape=oval
    fillcolor="#12232C"
    color="#65A9D0"
  ]

  container [
    label=<<B>App Container</B>>
    URL="../platform/appcontainer/"
    fillcolor="#17251A"
    color="#70A87B"
    group="app-runtime"
  ]
  sdk [
    label=<<B>packages/sdk</B><BR/><FONT POINT-SIZE="10">identity(), can(), and scope()</FONT>>
    URL="../packages/sdk/"
    fillcolor="#17251A"
    color="#70A87B"
  ]
  egress [
    label=<<B>Egress</B><BR/><FONT POINT-SIZE="10">Allowlist, credentials, and call log</FONT>>
    URL="../packages/egress/"
    fillcolor="#17251A"
    color="#70A87B"
  ]
  apis [
    label="Approved external APIs"
    shape=oval
    fillcolor="#12232C"
    color="#65A9D0"
  ]

  contracts [
    label=<<B>Contracts</B><BR/><FONT POINT-SIZE="10">Shared API schemas used across all surfaces</FONT>>
    URL="../packages/contracts/"
    fillcolor="#25221D"
    color="#B7A98D"
  ]

  legend [
    shape=plain
    margin=0
    label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#454842" BGCOLOR="#101210">
      <TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legend</B></TD></TR>
      <TR><TD BGCOLOR="#28210F" BORDER="1" COLOR="#D8AA35" WIDTH="24"></TD><TD ALIGN="LEFT">People and user surfaces</TD></TR>
      <TR><TD BGCOLOR="#17251A" BORDER="1" COLOR="#70A87B"></TD><TD ALIGN="LEFT">Core application and runtime</TD></TR>
      <TR><TD BGCOLOR="#28172A" BORDER="1" COLOR="#B56BAA"></TD><TD ALIGN="LEFT">Identity and request enforcement</TD></TR>
      <TR><TD BGCOLOR="#12232C" BORDER="1" COLOR="#65A9D0"></TD><TD ALIGN="LEFT">Infrastructure and external services</TD></TR>
      <TR><TD BGCOLOR="#25221D" BORDER="1" COLOR="#B7A98D"></TD><TD ALIGN="LEFT">Shared code</TD></TR>
      <TR><TD BORDER="1" COLOR="#426C84"></TD><TD ALIGN="LEFT">Outlined areas show hosting location</TD></TR>
    </TABLE>>
  ]

  subgraph cluster_surfaces {
    label="Builder surfaces"
    style="rounded,filled"
    color="#6F5B27"
    fillcolor="#121412"
    fontcolor="#D8AA35"
    fontsize=11
    penwidth=1.1
    margin=18
    actor
    cli
    dashboard
  }

  subgraph cluster_control_plane {
    label="Control plane"
    style="rounded,filled"
    color="#416448"
    fillcolor="#121412"
    fontcolor="#70A87B"
    fontsize=11
    penwidth=1.1
    margin=18
    backend
    depot
    postgres
  }

  subgraph cluster_cloudflare {
    label="Cloudflare"
    style="rounded,filled"
    color="#426C84"
    fillcolor="#121412"
    fontcolor="#65A9D0"
    fontsize=11
    penwidth=1.1
    margin=18
    r2
    registry
    worker
    gateway
    container
    sdk
    egress
  }

  postgres_gateway [
    label=<<B>Postgres</B>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]

  subgraph cluster_shared {
    label="Shared code"
    style="rounded,filled"
    color="#675F50"
    fillcolor="#121412"
    fontcolor="#B7A98D"
    fontsize=11
    penwidth=1.1
    margin=18
    contracts
  }

  { rank=same; actor; viewer; contracts; legend }
  { rank=same; cli; dashboard }
  { rank=same; postgres; backend; r2; worker; gateway; postgres_gateway }
  { rank=same; depot; registry; container; oidc }
  { rank=same; sdk; egress; apis }

  actor -> cli [label="push", color="#D8AA35", fontcolor="#D8AA35"]
  actor -> dashboard [label="manage", color="#D8AA35", fontcolor="#D8AA35"]
  cli -> backend [color="#D8AA35", fontcolor="#D8AA35"]
  dashboard -> backend [color="#D8AA35", fontcolor="#D8AA35"]
  backend -> postgres [color="#D8AA35", fontcolor="#D8AA35"]
  backend -> r2 [label="store blobs", color="#D8AA35", fontcolor="#D8AA35"]
  backend -> depot [label="build context", color="#D8AA35", fontcolor="#D8AA35"]
  depot -> registry [label="push image", color="#D8AA35", fontcolor="#D8AA35"]
  backend -> worker [label="deploy and roll out", color="#D8AA35", fontcolor="#D8AA35"]
  registry -> container [label="app image", color="#D8AA35", fontcolor="#D8AA35"]

  viewer -> worker [label="HTTPS request"]
  worker -> gateway [label="mint or refresh"]
  gateway -> postgres_gateway [label="sessions, grants, audit", constraint=false]
  gateway -> oidc [dir=both, label="central login"]
  worker -> container [label="verified request"]
  container -> sdk [label="read identity"]
  container -> egress [label="outbound request"]
  egress -> apis [label="allowlisted request"]

  actor -> viewer [style=invis, weight=20]
  viewer -> contracts [style=invis, weight=20]
  contracts -> legend [style=invis, weight=20]
  cli -> dashboard [style=invis, weight=20]
  postgres -> backend [style=invis, weight=20]
  backend -> r2 [style=invis, weight=20]
  registry -> viewer [style=invis, weight=20]
  sdk -> egress [style=invis, weight=20]
}

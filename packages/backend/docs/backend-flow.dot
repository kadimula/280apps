digraph BackendArchitecture {
  graph [
    rankdir=LR
    bgcolor="#080A09"
    pad="0.45"
    nodesep="0.42"
    ranksep="0.82"
    splines=polyline
    newrank=true
    outputorder=edgesfirst
    fontname="Arial"
    fontcolor="#F5F2EA"
    label=<<B>Backend architecture</B>>
    labelloc=t
    labeljust=l
    fontsize=28
  ]

  node [
    shape=rect
    style="rounded,filled"
    margin="0.22,0.16"
    fontname="Arial"
    fontsize=12
    color="#454842"
    fontcolor="#F5F2EA"
    fillcolor="#151816"
    penwidth=1.4
  ]

  edge [
    fontname="Arial"
    fontsize=10
    fontcolor="#CAC7BF"
    color="#D7D4CC"
    arrowsize=0.72
    penwidth=1.35
  ]

  cli [
    label=<<B>280 CLI</B><BR/><FONT POINT-SIZE="10">Sync, blob upload, status, and device login</FONT>>
    shape=oval
    fillcolor="#28210F"
    color="#D8AA35"
  ]
  dashboard [
    label=<<B>Dashboard and browser</B><BR/><FONT POINT-SIZE="10">OIDC, apps, sharing, secrets, and preview</FONT>>
    shape=oval
    fillcolor="#28210F"
    color="#D8AA35"
  ]
  agents [
    label=<<B>Agents</B><BR/><FONT POINT-SIZE="10">Setup and platform support documents</FONT>>
    shape=oval
    fillcolor="#28210F"
    color="#D8AA35"
  ]

  api [
    label=<<B>Hono HTTP API</B><BR/><FONT POINT-SIZE="10">Authenticate, validate, and translate</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  deploy [
    label=<<B>Deploy service</B><BR/><FONT POINT-SIZE="10">Resolve app, preflight, sync, and status</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  auth [
    label=<<B>Auth and app management</B><BR/><FONT POINT-SIZE="10">OIDC, device approval, grants, and secrets</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  activator [
    label=<<B>Container deployment coordinator</B><BR/><FONT POINT-SIZE="10">Serialize build, rollout, and delete</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  runtime [
    label=<<B>Container builder</B><BR/><FONT POINT-SIZE="10">Build context, policy, and secret delivery</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]

  postgres [
    label=<<B>Postgres store</B><BR/><FONT POINT-SIZE="10">Control state, identity, policy, and audit</FONT>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  blobs [
    label=<<B>R2 blob store</B><BR/><FONT POINT-SIZE="10">App scoped content by digest</FONT>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  kms [
    label=<<B>Secret encryption</B><BR/><FONT POINT-SIZE="10">Envelope cipher with KMS or local wrapper</FONT>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  oidc [
    label=<<B>Google OIDC</B>>
    shape=oval
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  depot [
    label=<<B>Depot remote BuildKit</B><BR/><FONT POINT-SIZE="10">Build and push container image</FONT>>
    shape=oval
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  cloudflare [
    label=<<B>Per app Worker and Container</B><BR/><FONT POINT-SIZE="10">Identity, route gates, egress, and application</FONT>>
    fillcolor="#17251A"
    color="#70A87B"
  ]
  gateway [
    label=<<B>Identity gateway</B><BR/><FONT POINT-SIZE="10">Reads registered policy and grants</FONT>>
    fillcolor="#17251A"
    color="#70A87B"
  ]

  legend [
    shape=plain
    margin=0
    label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#454842" BGCOLOR="#101210">
      <TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legend</B></TD></TR>
      <TR><TD BGCOLOR="#28210F" BORDER="1" COLOR="#D8AA35" WIDTH="24"></TD><TD ALIGN="LEFT">Clients</TD></TR>
      <TR><TD BGCOLOR="#28172A" BORDER="1" COLOR="#B56BAA"></TD><TD ALIGN="LEFT">Control plane behavior</TD></TR>
      <TR><TD BGCOLOR="#12232C" BORDER="1" COLOR="#65A9D0"></TD><TD ALIGN="LEFT">Platform state and external services</TD></TR>
      <TR><TD BGCOLOR="#17251A" BORDER="1" COLOR="#70A87B"></TD><TD ALIGN="LEFT">Application data plane</TD></TR>
      <TR><TD BORDER="1" COLOR="#426C84"></TD><TD ALIGN="LEFT">Outlined area is the backend process</TD></TR>
    </TABLE>>
  ]

  subgraph cluster_backend {
    label="Node control plane process"
    style="rounded,filled"
    color="#426C84"
    fillcolor="#121412"
    fontcolor="#65A9D0"
    fontsize=11
    penwidth=1.1
    margin=18
    api
    deploy
    auth
    activator
    runtime
  }

  { rank=same; cli; dashboard; agents; legend }
  { rank=same; deploy; auth }
  { rank=same; activator; runtime }
  { rank=same; postgres; blobs; kms; oidc; depot; cloudflare; gateway }

  cli -> api [label="Deploy and device API", color="#D8AA35", fontcolor="#D8AA35"]
  dashboard -> api [label="Session authenticated API", color="#D8AA35", fontcolor="#D8AA35"]
  agents -> api [label="Public documentation", color="#D8AA35", fontcolor="#D8AA35"]

  api -> deploy [label="User scoped Port", color="#B56BAA", fontcolor="#B56BAA"]
  api -> auth [label="Browser and management calls", color="#B56BAA", fontcolor="#B56BAA"]
  deploy -> activator [label="Content complete deploy", color="#B56BAA", fontcolor="#B56BAA"]
  activator -> runtime [label="Build, rollout, or delete", color="#B56BAA", fontcolor="#B56BAA", constraint=false]

  deploy -> postgres [label="Apps and deploy state"]
  deploy -> blobs [label="Missing and uploaded content"]
  auth -> postgres [label="Users, grants, sessions, and secrets"]
  auth -> kms [label="Seal and reveal values"]
  auth -> oidc [dir=both, label="Authorization code flow"]
  runtime -> blobs [label="Read build context"]
  runtime -> kms [label="Reveal declared secrets"]
  runtime -> depot [label="Remote image build"]
  runtime -> cloudflare [label="Immediate container rollout", color="#70A87B", fontcolor="#70A87B"]
  kms -> cloudflare [label="Worker secret bindings", color="#70A87B", fontcolor="#70A87B", constraint=false]
  postgres -> gateway [label="Policy and grants", color="#70A87B", fontcolor="#70A87B"]

  cli -> dashboard [style=invis, weight=10]
  dashboard -> agents [style=invis, weight=10]
  agents -> legend [style=invis, weight=10]
  deploy -> auth [style=invis, weight=10]
  postgres -> blobs [style=invis, weight=10]
  blobs -> kms [style=invis, weight=10]
  kms -> oidc [style=invis, weight=10]
  oidc -> depot [style=invis, weight=10]
  depot -> cloudflare [style=invis, weight=10]
  cloudflare -> gateway [style=invis, weight=10]
}

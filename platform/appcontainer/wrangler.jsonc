{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "280-appcontainer",
	"main": "src/worker.js",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],

	// Reference binding shape for the harness. The roll generates the real per-app
	// config (packages/backend/.../registry-builder.ts), pointing `image` at the
	// pushed registry ref; this file is not deployed directly. Locked security
	// defaults (enableInternet=false, interceptHttps=true) live in src/container.js.
	"durable_objects": {
		"bindings": [{ "class_name": "App280Container", "name": "APP" }]
	},
	"containers": [
		{
			"class_name": "App280Container",
			"image": "registry.cloudflare.com/<app-image>",
			"instance_type": "dev",
			"max_instances": 1
		}
	],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["App280Container"] }]
}

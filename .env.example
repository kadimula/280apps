# Canonical platform configuration.
# Railway supplies RAILWAY_ENVIRONMENT_NAME to the backend. The gateway sets
# DEPLOYMENT_ENVIRONMENT in its development Wrangler configuration.
PLATFORM_DOMAIN=280apps.com
APP_SERVING_DOMAIN=280apps.run

# Backend database and build credentials.
DATABASE_URL=postgresql://user:changeme@host:5432/db
MIGRATE_DATABASE_URL=
TEST_DATABASE_URL=
DEPOT_BUILD_PROJECT_ID=
DEPOT_API_TOKEN=changeme
CLOUDFLARE_ACCOUNT_ID=changeme
CLOUDFLARE_DEPLOY_API_TOKEN=changeme

# Google OIDC credentials used by the backend and gateway.
GOOGLE_OIDC_CLIENT_ID=changeme
GOOGLE_OIDC_CLIENT_SECRET=changeme

# Dedicated Google OAuth client and Picker configuration for app integrations.
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=

# Microsoft OIDC credentials used by the gateway.
MICROSOFT_ENTRA_OIDC_CLIENT_ID=changeme
MICROSOFT_ENTRA_OIDC_CLIENT_SECRET=changeme

# Gateway ECDSA P256 signing key encoded as a JWK JSON string.
IDENTITY_SIGNING_PRIVATE_JWK=

# Backend app secret encryption. Configure either KMS or the local development key.
APP_SECRET_KMS_KEY_NAME=
APP_SECRET_KMS_CREDENTIALS_JSON=
APP_SECRET_LOCAL_MASTER_KEY=
APP_SECRET_LOCAL_KEY_ID=

# Optional backend controls.
MINIMUM_SUPPORTED_CLI_VERSION=
ADDITIONAL_FRAME_ANCESTORS=

# Optional R2 blob storage. Leave all four empty to use the Railway volume or
# data/blobs in a local development process.
BLOB_S3_ENDPOINT=
BLOB_S3_BUCKET=
BLOB_S3_ACCESS_KEY_ID=
BLOB_S3_SECRET_ACCESS_KEY=
BLOB_S3_REGION=auto
BLOB_S3_FORCE_PATH_STYLE=true

# Derived values are intentionally not configurable.
#
# Dashboard origin
# Control plane API origin
# Device activation URL
# Frame ancestor for the dashboard
# Authentication host and identity issuer
# Identity gateway service name
# Application hostname suffix
# Session cookie domain and names
# Database schema
# Worker entrypoint
# Session and machine token lifetimes
# Login rate limits
# Cleanup interval
# Local blob directory on Railway

# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# Loaded via Node 20+ native flag: `node --env-file=.env dist/index.js`

# Control-plane Postgres (Neon). Fetch with:
#   neonctl connection-string --project-id <project-id>
DATABASE_URL=

# Store test suite (packages/backend/test). Creates a fresh schema per test.
TEST_DATABASE_URL=

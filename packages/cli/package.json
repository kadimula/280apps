    "skill:check": "node dist/bin.js setup --check"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@280/contracts": "workspace:*",
    "tsup": "^8.3.0"
  }
}

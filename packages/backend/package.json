{
  "name": "@280/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authsvc": {
      "types": "./dist/authsvc.d.ts",
      "import": "./dist/authsvc.js"
    },
    "./auth/oidc": {
      "types": "./dist/auth/oidc.d.ts",
      "import": "./dist/auth/oidc.js"
    },
    "./store": {
      "types": "./dist/store/store.d.ts",
      "import": "./dist/store/store.js"
    },
    "./seams": {
      "types": "./dist/seams.d.ts",
      "import": "./dist/seams.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "./scripts/dev-local.sh",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/docs', 'dist/docs', { recursive: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/migrate.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@280/contracts": "workspace:*",
    "@aws-sdk/client-s3": "^3.700.0",
    "@googleapis/sheets": "^14.0.0",
    "@hono/node-server": "^2.0.0",
    "google-auth-library": "^10.1.0",
    "hono": "^4.13.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "wrangler": "^4.116.0"
  }
}

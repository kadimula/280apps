{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "280-gateway",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-23",
	// Reuses the control plane's Auth (node:crypto) and pg store over Hyperdrive.
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": { "enabled": true },
	"placement": { "mode": "smart" },

	// Container-only serving: the gateway is the identity mint/JWKS service, not an
	// app proxy. It owns ONLY the auth host; each app is its own Worker on its own
	// <script>.280apps.run/* route (emitted by the roll) that calls this gateway's
	// GatewayRPC over a service binding. The legacy dispatch wildcard was removed in
	// the Phase 3 cutover.
	"routes": [{ "pattern": "auth.280apps.run/*", "zone_name": "280apps.run" }],

	// The prod Hyperdrive over the prod control-plane Postgres. Only this Worker needs
	// Hyperdrive; app Workers never touch the DB.
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "ad3e4d13e7da4b2f89b9821c70413ddf" }],

	// Secrets via `wrangler secret put`: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
	// ENTRA_CLIENT_ID, ENTRA_CLIENT_SECRET, ID_SIGNING_JWK (ECDSA P-256 private
	// JWK; generate with `node scripts/gen-signing-key.mjs`).
	"vars": {
		"TWO80_DB_SCHEMA": "platform",
		"TWO80_APP_DOMAIN": "280apps.run",
		"TWO80_AUTH_HOST": "auth.280apps.run",
		"TWO80_COOKIE_DOMAIN": ".280apps.run",
		"TWO80_ID_ISSUER": "https://auth.280apps.run",
		"TWO80_ID_TTL_SECS": "30",
		"TWO80_ID_SIGNING_KID": "k1",
		"TWO80_ENTRA_TENANT": "organizations",
		"TWO80_FALLBACK_REDIRECT": "https://280apps.com"
	}
}

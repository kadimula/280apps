digraph ContractsArchitecture {
  graph [
    rankdir=LR
    bgcolor="#080A09"
    pad="0.45"
    nodesep="0.42"
    ranksep="0.82"
    splines=polyline
    newrank=true
    outputorder=edgesfirst
    fontname="Arial"
    fontcolor="#F5F2EA"
    label=<<B>Contracts architecture</B>>
    labelloc=t
    labeljust=l
    fontsize=28
  ]

  node [
    shape=rect
    style="rounded,filled"
    margin="0.22,0.16"
    fontname="Arial"
    fontsize=12
    color="#454842"
    fontcolor="#F5F2EA"
    fillcolor="#151816"
    penwidth=1.4
  ]

  edge [
    fontname="Arial"
    fontsize=10
    fontcolor="#CAC7BF"
    color="#D7D4CC"
    arrowsize=0.72
    penwidth=1.35
  ]

  cli [
    label=<<B>CLI</B><BR/><FONT POINT-SIZE="10">Build manifest, push, retry, and render fixes</FONT>>
    shape=oval
    fillcolor="#28210F"
    color="#D8AA35"
  ]
  backend [
    label=<<B>Backend</B><BR/><FONT POINT-SIZE="10">Validate, persist, and implement deploy behavior</FONT>>
    shape=oval
    fillcolor="#28210F"
    color="#D8AA35"
  ]
  runtime [
    label=<<B>Gateway, SDK, and egress</B><BR/><FONT POINT-SIZE="10">Enforce identity and application policy</FONT>>
    shape=oval
    fillcolor="#28210F"
    color="#D8AA35"
  ]

  models [
    label=<<B>Wire models and schemas</B><BR/><FONT POINT-SIZE="10">Deploy, auth, manifest, policy, and preview</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  port [
    label=<<B>Deploy Port</B><BR/><FONT POINT-SIZE="10">Sync, stream blobs, status, and delete</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  policy [
    label=<<B>Policy and digest helpers</B><BR/><FONT POINT-SIZE="10">Normalize, validate, resolve, and derive</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  identity [
    label=<<B>Signed identity scheme</B><BR/><FONT POINT-SIZE="10">Shared ES256 claims, signer, and verifier</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]
  errors [
    label=<<B>Typed errors and versions</B><BR/><FONT POINT-SIZE="10">Stable recovery and compatibility decisions</FONT>>
    fillcolor="#28172A"
    color="#B56BAA"
  ]

  http [
    label=<<B>HTTP adapters</B><BR/><FONT POINT-SIZE="10">Production deploy and device clients</FONT>>
    fillcolor="#17251A"
    color="#70A87B"
  ]
  fake [
    label=<<B>In memory fake</B><BR/><FONT POINT-SIZE="10">Deterministic behavior and fault injection</FONT>>
    fillcolor="#17251A"
    color="#70A87B"
  ]
  suite [
    label=<<B>Conformance suite</B><BR/><FONT POINT-SIZE="10">One behavioral contract for every Port</FONT>>
    fillcolor="#17251A"
    color="#70A87B"
  ]
  api [
    label=<<B>Backend API v1</B>>
    shape=oval
    fillcolor="#12232C"
    color="#65A9D0"
  ]
  vectors [
    label=<<B>Protocol vectors</B><BR/><FONT POINT-SIZE="10">Byte stable derivation fixtures</FONT>>
    shape=cylinder
    fillcolor="#12232C"
    color="#65A9D0"
  ]

  legend [
    shape=plain
    margin=0
    label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#454842" BGCOLOR="#101210">
      <TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legend</B></TD></TR>
      <TR><TD BGCOLOR="#28210F" BORDER="1" COLOR="#D8AA35" WIDTH="24"></TD><TD ALIGN="LEFT">Package consumers</TD></TR>
      <TR><TD BGCOLOR="#28172A" BORDER="1" COLOR="#B56BAA"></TD><TD ALIGN="LEFT">Core contract</TD></TR>
      <TR><TD BGCOLOR="#17251A" BORDER="1" COLOR="#70A87B"></TD><TD ALIGN="LEFT">Adapters and executable contract</TD></TR>
      <TR><TD BGCOLOR="#12232C" BORDER="1" COLOR="#65A9D0"></TD><TD ALIGN="LEFT">External service and fixtures</TD></TR>
      <TR><TD BORDER="1" COLOR="#426C84"></TD><TD ALIGN="LEFT">Outlined area is the contracts package</TD></TR>
    </TABLE>>
  ]

  subgraph cluster_contracts {
    label="@280/contracts"
    style="rounded,filled"
    color="#426C84"
    fillcolor="#121412"
    fontcolor="#65A9D0"
    fontsize=11
    penwidth=1.1
    margin=18
    models
    port
    policy
    identity
    errors
    http
    fake
    suite
  }

  { rank=same; cli; backend; runtime; legend }
  { rank=same; models; port }
  { rank=same; policy; identity; errors }
  { rank=same; http; fake; suite }
  { rank=same; api; vectors }

  cli -> models [label="Construct and parse", color="#D8AA35", fontcolor="#D8AA35"]
  cli -> port [label="Call transport independent API", color="#D8AA35", fontcolor="#D8AA35"]
  backend -> models [label="Validate wire values", color="#D8AA35", fontcolor="#D8AA35"]
  backend -> port [label="Implement behavior", color="#D8AA35", fontcolor="#D8AA35"]
  runtime -> policy [label="Enforce shared policy", color="#D8AA35", fontcolor="#D8AA35"]
  runtime -> identity [label="Mint and verify", color="#D8AA35", fontcolor="#D8AA35"]

  models -> policy [label="Typed manifest"]
  models -> errors [label="Stable wire shape"]
  port -> http [label="Production implementation", color="#70A87B", fontcolor="#70A87B"]
  port -> fake [label="Test implementation", color="#70A87B", fontcolor="#70A87B"]
  errors -> http [label="Normalize failures"]
  suite -> port [label="Exercise required behavior", color="#70A87B", fontcolor="#70A87B", constraint=false]
  http -> api [label="API v1 requests"]
  fake -> suite [label="Conformance target", color="#70A87B", fontcolor="#70A87B"]
  http -> suite [label="Conformance target", color="#70A87B", fontcolor="#70A87B"]
  policy -> vectors [label="Canonical outputs"]

  cli -> backend [style=invis, weight=10]
  backend -> runtime [style=invis, weight=10]
  runtime -> legend [style=invis, weight=10]
  models -> port [style=invis, weight=10]
  policy -> identity [style=invis, weight=10]
  identity -> errors [style=invis, weight=10]
  api -> vectors [style=invis, weight=10]
}

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "280-gateway",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-23",
	// Reuses the control plane's Auth (node:crypto) and pg store over Hyperdrive.
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": { "enabled": true },
	"placement": { "mode": "smart" },

	// Container-only serving: the gateway is the identity mint/JWKS service, not an
	// app proxy. It owns ONLY the auth host; each app is its own Worker on its own
	// <script>.280apps.run/* route (emitted by the roll) that calls this gateway's
	// GatewayRPC over a service binding. The legacy dispatch wildcard was removed in
	// the Phase 3 cutover.
	"routes": [{ "pattern": "auth.280apps.run/*", "zone_name": "280apps.run" }],

	// The prod Hyperdrive over the prod control-plane Postgres. Only this Worker needs
	// Hyperdrive; app Workers never touch the DB.
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "ad3e4d13e7da4b2f89b9821c70413ddf" }],

	// Secrets via `wrangler secret put`: GOOGLE_OIDC_CLIENT_ID,
	// GOOGLE_OIDC_CLIENT_SECRET, MICROSOFT_ENTRA_OIDC_CLIENT_ID,
	// MICROSOFT_ENTRA_OIDC_CLIENT_SECRET, IDENTITY_SIGNING_PRIVATE_JWK.
	"vars": {
		"PLATFORM_DOMAIN": "280apps.com",
		"APP_SERVING_DOMAIN": "280apps.run"
	}
}

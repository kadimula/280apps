{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "280-dispatcher",
	"main": "src/index.js",
	"compatibility_date": "2026-07-23",
	"workers_dev": false,
	"observability": { "enabled": true },

	// Universal SSL covers *.280apps.run as one cert, so app hostnames never hit
	// Certificate Transparency logs — which keeps unlisted-link sharing unlisted.
	"routes": [{ "pattern": "*.280apps.run/*", "zone_name": "280apps.run" }],

	// Binding into the namespace user Workers are uploaded to.
	"dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "apps" }],

	"vars": { "WEB_ORIGIN": "https://280apps.com" }

	// Deliberately no compatibility_flags: the dispatcher is a thin pipe; nodejs_compat
	// and global_fetch_strictly_public belong to tenant scripts, set at upload time.
}

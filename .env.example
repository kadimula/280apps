# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# The control plane runs as a plain Node service (packages/backend/src/main.ts):
#   pnpm --filter @280/backend build && node --env-file=.env packages/backend/dist/main.js
# On Railway these become the service's environment variables; the same file
# documents the full set the cutover needs.

# --- Postgres (Neon, shared with the gateway; the Node host dials it directly) ---
# Fetch with: neonctl connection-string --project-id <project-id>
DATABASE_URL=
# Schema the platform's tables live in (shares a database without sharing a namespace).
TWO80_DB_SCHEMA=platform

# Store test suite (packages/backend/test). Creates a fresh schema per test.
TEST_DATABASE_URL=

# --- Runtime (where user apps run) ---
# container = ship build contexts to the self-hosted Docker build host (production).
# memory    = record deploys but host nothing (local loop; skips the build box).
TWO80_RUNTIME=container
# Build home. 'http' = ship contexts to the self-hosted Docker build host (the
# default, unchanged). 'depot' = managed remote BuildKit, built daemonless from
# this service. Unset falls back to 'depot' only when DEPOT_TOKEN is set, else
# 'http' — so leaving all the depot vars empty keeps the current behavior.
TWO80_BUILDER=
# --- http builder (TWO80_BUILDER=http) ---
# The self-hosted Docker build host the container runtime ships contexts to, and
# the shared secret that authenticates to it. Required when builder=http.
TWO80_BUILD_HOST=
TWO80_BUILD_TOKEN=
# --- depot builder (TWO80_BUILDER=depot) ---
# Depot organization token authorizing remote builds.
DEPOT_TOKEN=
# Pin every build to one Depot project (shared layer cache). Leave empty to resolve
# an isolated project per app via the Depot API.
DEPOT_PROJECT_ID=
# Cloudflare account id (registry username + the account the app rolls under) and an
# API token scoped to containers + registry. Used to push the image and roll the app.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# The App280Container harness Worker the generated roll config points `main` at,
# supplied by the runtime image (not the app source).
TWO80_WORKER_ENTRY=worker.js

# --- Blob store (Cloudflare R2 over its S3 API) ---
# Set all four to use R2/S3; leave all four empty for a local filesystem store
# (dev only, not durable across hosts). A partial set is a startup error.
TWO80_S3_ENDPOINT=          # e.g. https://<accountid>.r2.cloudflarestorage.com
TWO80_S3_BUCKET=
TWO80_S3_ACCESS_KEY_ID=
TWO80_S3_SECRET_ACCESS_KEY=
TWO80_S3_REGION=auto        # R2 uses "auto"
TWO80_S3_FORCE_PATH_STYLE=true
# Filesystem blob dir, used only when the S3 vars are unset (local loop).
TWO80_BLOBS=data/blobs

# --- Browser login (Google OIDC) ---
# Unset leaves the deploy API serving but the web surface unable to sign anyone in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google returns the browser; must match the console's redirect URI.
TWO80_API_ORIGIN=https://api.280apps.com
# The only origin a post-login redirect may land on.
TWO80_FRONTEND_ORIGIN=https://www.280apps.com
# Empty is host-only (localhost dev); ".280apps.com" shares the session cookie
# between api and www in production.
TWO80_COOKIE_DOMAIN=
TWO80_SESSION_TTL_DAYS=30

# --- HTTP + misc tunables ---
# Railway sets PORT; TWO80_ADDR (host:port) is the local-loop fallback.
# PORT=8080
TWO80_ADDR=:8080
TWO80_LOG_FORMAT=json        # json for shipped logs, text for the local loop
TWO80_APP_DOMAIN=280apps.run
TWO80_VERIFICATION_URI=https://280apps.com/activate
# How often the cleanup sweep runs (expired sessions/device codes/rate windows).
TWO80_SWEEP_INTERVAL_SECS=3600

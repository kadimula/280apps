{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "280-dispatcher-development",
	"main": "src/index.js",
	"compatibility_date": "2026-07-23",
	"workers_dev": false,
	"observability": { "enabled": true },

	// This route's longer literal tail is more specific than prod's *.280apps.run/*, and
	// prod script labels never end in "-development", so dev routing can't shadow prod.
	"routes": [{ "pattern": "*-development.280apps.run/*", "zone_name": "280apps.run" }],

	// Binding into the development dispatch namespace user Workers upload to.
	"dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "apps-development" }],

	// HOST_SUFFIX turns on -development suffix stripping in src/index.js; prod sets none.
	"vars": { "WEB_ORIGIN": "https://280apps.com", "HOST_SUFFIX": "-development" }

	// Same as prod: no compatibility_flags here; those are set per tenant script at upload.
}

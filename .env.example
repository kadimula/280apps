# Copy to .env and fill in. .env is gitignored; .env.example is committed.
#
# THIS REPO IS PUBLIC. This file documents variable NAMES and shapes only.
# Never commit a real token, key, connection string, or client secret here.
# Every [SECRET] value below is a placeholder; real values live outside the repo
# (Railway/Worker env, a secrets manager). See docs/dev-environment.md.
#
# Two components read these; each variable is read by the code cited:
#   - Control-plane backend (Node, ships on Railway):
#       packages/backend/src/config.ts (ConfigVars), src/main.ts, src/migrate.ts
#     Run locally: pnpm --filter @280/backend build \
#       && node --env-file=.env packages/backend/dist/main.js
#   - Gateway Worker (Cloudflare):
#       packages/gateway/src/config.ts (Env)
#
# Unset config vars fall back to the defaults shown as literals below.

# =============================================================================
# SECRETS  ([SECRET] — placeholders only; never commit real values)
# =============================================================================

# --- Postgres (backend; the Node host dials it directly) ---
# [SECRET] Primary connection string. Fetch with:
#   neonctl connection-string --project-id <project-id>
DATABASE_URL=postgresql://user:changeme@host:5432/db
# [SECRET] Optional override for the CI migrate runner (src/migrate.ts); falls
# back to DATABASE_URL when unset.
MIGRATE_DATABASE_URL=
# [SECRET] Store test suite only (packages/backend/test); unset skips those tests.
TEST_DATABASE_URL=

# --- OIDC identity providers (backend + gateway) ---
# [SECRET] Google OIDC. Backend uses these for device/browser login; the gateway
# uses them at the edge front door.
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
# [SECRET] Microsoft Entra OIDC (gateway only).
ENTRA_CLIENT_ID=changeme
ENTRA_CLIENT_SECRET=changeme
# [SECRET] Gateway ECDSA P-256 signing key, a JWK as a JSON string. Only the
# gateway Worker holds it; it signs the injected identity headers.
ID_SIGNING_JWK=

# --- Build + registry (backend; depot builder / registry push / wrangler roll) ---
# [SECRET] Cloudflare account id (registry username + the account apps roll under).
CLOUDFLARE_ACCOUNT_ID=changeme
# [SECRET] Cloudflare API token scoped to containers + registry.
CLOUDFLARE_API_TOKEN=changeme
# [SECRET] Depot org token authorizing remote BuildKit builds (builder=depot).
DEPOT_TOKEN=changeme
# [SECRET] Shared secret authenticating to the self-hosted Docker build host
# (builder=http).
TWO80_BUILD_TOKEN=changeme

# --- Blob store credentials (backend; Cloudflare R2 over its S3 API) ---
# [SECRET] Set alongside the non-secret TWO80_S3_* below. All four S3 vars must be
# set together (a partial set is a startup error) or all empty for local disk.
TWO80_S3_ACCESS_KEY_ID=changeme
TWO80_S3_SECRET_ACCESS_KEY=changeme

# =============================================================================
# NON-SECRET CONFIG  (safe to commit as literals)
# =============================================================================

# --- Backend: core ---
# container = run user apps in the container runtime (production).
# memory    = record deploys but host nothing (local loop; skips the build box).
TWO80_RUNTIME=container
TWO80_LOG_FORMAT=json           # json for shipped logs, text for the local loop
TWO80_DB_SCHEMA=platform        # schema the platform's tables live in
TWO80_APP_DOMAIN=280apps.run    # zone user apps are served on
# Host label inserted before the app domain. Empty in prod; "-development" makes
# apps serve at *-development.280apps.run in the dev environment.
TWO80_APP_HOST_SUFFIX=
TWO80_API_ORIGIN=https://api.280apps.com       # where Google returns the browser
TWO80_FRONTEND_ORIGIN=https://www.280apps.com  # only origin a post-login redirect may land on
TWO80_VERIFICATION_URI=https://280apps.com/activate  # device-login approval page
# Empty is host-only (localhost dev); ".280apps.com" shares the session cookie
# between api and www.
TWO80_COOKIE_DOMAIN=
TWO80_OPEN_SIGNUP=              # "1" opens signup to any successful login
TWO80_MIN_CLI_VERSION=         # reject pushes from CLIs older than this (empty = no floor)
TWO80_SESSION_TTL_DAYS=30
TWO80_LOGIN_RATE_WINDOW_SECS=600
TWO80_LOGIN_RATE_MAX=30

# --- Backend: build home ---
# 'http' = ship contexts to the self-hosted Docker build host (default).
# 'depot' = managed remote BuildKit. Unset falls back to 'depot' only when
# DEPOT_TOKEN is set, else 'http'.
TWO80_BUILDER=
TWO80_BUILD_HOST=              # self-hosted Docker build host URL (builder=http)
DEPOT_PROJECT_ID=             # pin every build to one Depot project; empty resolves per app
# The App280Container harness Worker the generated roll config points `main` at,
# supplied by the runtime image (not the app source).
TWO80_WORKER_ENTRY=worker.js

# --- Backend: blob store (Cloudflare R2 over its S3 API) ---
# Set these with the [SECRET] TWO80_S3_ACCESS_KEY_ID / TWO80_S3_SECRET_ACCESS_KEY
# above to use R2; leave all four empty for a local filesystem store (dev only).
TWO80_S3_ENDPOINT=            # e.g. https://<accountid>.r2.cloudflarestorage.com
TWO80_S3_BUCKET=
TWO80_S3_REGION=auto          # R2 uses "auto"
TWO80_S3_FORCE_PATH_STYLE=true
TWO80_BLOBS=data/blobs        # filesystem blob dir, used only when the S3 vars are unset

# --- Backend: HTTP + misc tunables ---
# Railway sets PORT; TWO80_ADDR (host:port) is the local-loop fallback.
# PORT=8080
TWO80_ADDR=:8080
# How often the cleanup sweep runs (expired sessions/device codes/rate windows).
TWO80_SWEEP_INTERVAL_SECS=3600

# --- Gateway: edge front door (Cloudflare Worker) ---
# Shared with the backend above: TWO80_DB_SCHEMA, TWO80_APP_DOMAIN,
# TWO80_APP_HOST_SUFFIX, TWO80_COOKIE_DOMAIN, TWO80_SESSION_TTL_DAYS,
# TWO80_LOGIN_RATE_WINDOW_SECS, TWO80_LOGIN_RATE_MAX.
TWO80_AUTH_HOST=              # auth host; default auth.<TWO80_APP_DOMAIN>
TWO80_ID_ISSUER=             # signed-identity issuer; default https://<auth host>
TWO80_ID_TTL_SECS=120        # injected identity token lifetime
TWO80_ID_SIGNING_KID=k1      # key id in the identity JWT header
TWO80_ENTRA_TENANT=organizations   # Entra tenant for Microsoft OIDC
TWO80_FALLBACK_REDIRECT=https://280apps.com  # redirect when no app target resolves
# Worker bindings (NOT plain env vars — declared in the gateway's wrangler config):
#   HYPERDRIVE     Hyperdrive binding to the control-plane Postgres.
#   APP_CONTAINER  Durable Object namespace of App280Container (one per app).

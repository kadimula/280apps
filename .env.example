# Copy to .env and fill in. .env is gitignored; .env.example is committed.
#
# THIS REPO IS PUBLIC. This file documents variable NAMES and shapes only.
# Never commit a real token, key, connection string, or client secret here.
# Every [SECRET] value below is a placeholder; real values live outside the repo
# (Railway/Worker env, a secrets manager). See docs/dev-environment.md.
#
# Two components read these; each variable is read by the code cited:
#   - Control-plane backend (Node, ships on Railway):
#       packages/backend/src/config.ts (ConfigVars), src/main.ts, src/migrate.ts
#     Run locally: pnpm --filter @280/backend build \
#       && node --env-file=.env packages/backend/dist/main.js
#   - Gateway Worker (Cloudflare):
#       packages/gateway/src/config.ts (Env)
#
# Unset config vars fall back to the defaults shown as literals below.

# =============================================================================
# SECRETS  ([SECRET] — placeholders only; never commit real values)
# =============================================================================

# --- Postgres (backend; the Node host dials it directly) ---
# [SECRET] Primary PostgreSQL connection string from your database provider.
DATABASE_URL=postgresql://user:changeme@host:5432/db
# [SECRET] Optional override for the CI migrate runner (src/migrate.ts); falls
# back to DATABASE_URL when unset.
MIGRATE_DATABASE_URL=
# [SECRET] Store test suite only (packages/backend/test); unset skips those tests.
TEST_DATABASE_URL=

# --- OIDC identity providers (backend + gateway) ---
# [SECRET] Google OIDC. Backend uses these for device/browser login; the gateway
# uses them at the edge front door.
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
# [SECRET] Microsoft Entra OIDC (gateway only).
ENTRA_CLIENT_ID=changeme
ENTRA_CLIENT_SECRET=changeme
# [SECRET] Gateway ECDSA P-256 signing key, a JWK as a JSON string. Only the
# gateway Worker holds it; it signs the injected identity headers.
ID_SIGNING_JWK=

# --- App secret encryption (backend; the control plane's secrets table) ---
# Exactly one wrapping path may be configured; both set is a startup error, and
# neither set makes secret storage read-only (declared names list, writes refuse).
# Production/development use Cloud KMS; the local key is for dev loops/self-host.
# Full Cloud KMS key resource name that wraps each envelope data key, e.g.
# projects/<p>/locations/global/keyRings/<r>/cryptoKeys/<k>. Stamped into each
# envelope as its keyId. See 280-cloud/infrastructure/google-cloud-kms.md.
APP_SECRETS_KMS_KEY_NAME=
# [SECRET] Google service-account credential JSON (one line) authorized as
# cryptoKeyEncrypterDecrypter on the key above. Required with the key name.
APP_SECRETS_KMS_CREDENTIALS_JSON=
# [SECRET] Local master key that envelope-encrypts app secret values at rest,
# base64 of 32 random bytes (openssl rand -base64 32). Dev loop and self-host
# only; must not be deployed as the production design. Never held in the DB.
APP_SECRETS_LOCAL_MASTER_KEY=
# Stable label for the local key above, stamped into each envelope so a future key
# can be rotated in. Optional; defaults to a hash prefix of the key.
APP_SECRETS_LOCAL_KEY_ID=

# --- Build + registry (backend; depot builder / registry push / wrangler roll) ---
# [SECRET] Cloudflare account id (registry username + the account apps roll under).
CLOUDFLARE_ACCOUNT_ID=changeme
# [SECRET] Cloudflare API token scoped to containers + registry.
CLOUDFLARE_API_TOKEN=changeme
# [SECRET] Depot org token authorizing remote BuildKit builds.
DEPOT_TOKEN=changeme

# --- Blob store credentials (backend; Cloudflare R2 over its S3 API) ---
# [SECRET] Set alongside the non-secret BLOB_S3_* below. All four S3 vars must be
# set together (a partial set is a startup error) or all empty for local disk.
BLOB_S3_ACCESS_KEY_ID=changeme
BLOB_S3_SECRET_ACCESS_KEY=changeme

# =============================================================================
# NON-SECRET CONFIG  (safe to commit as literals)
# =============================================================================

# --- Backend: core ---
LOG_FORMAT=json           # json for shipped logs, text for the local loop
DATABASE_SCHEMA=platform        # schema the platform's tables live in
APP_BASE_DOMAIN=280apps.run    # zone user apps are served on
# Host label inserted before the app domain. Empty in prod; "-development" makes
# apps serve at *-development.280apps.run in the dev environment.
APP_HOST_SUFFIX=
BACKEND_API_ORIGIN=https://api.280apps.com  # browser callback origin and the sole host containers may call through @280/sdk
FRONTEND_ORIGIN=https://console.280apps.com  # the dashboard origin; only origin a post-login redirect may land on
# Space-separated origins allowed to frame an app host (CSP frame-ancestors), baked
# into each app Worker. Defaults to FRONTEND_ORIGIN, so the dashboard can
# always preview its own apps; set explicitly to allow additional embedders.
APP_FRAME_ANCESTORS=https://console.280apps.com
DEVICE_APPROVAL_URL=https://280apps.com/activate  # device-login approval page
# Empty is host-only (localhost dev); ".280apps.com" shares the session cookie
# between api and www.
SESSION_COOKIE_DOMAIN=
# Control-plane cookie names. Prod and dev share .280apps.com, so dev must set
# distinct names (e.g. 280_session_development / 280_oauth_development) to stay
# signed into both at once. Empty defaults to 280_session / 280_oauth.
SESSION_COOKIE_NAME=
OAUTH_COOKIE_NAME=
MINIMUM_CLI_VERSION=         # reject pushes from CLIs older than this (empty = no floor)
SESSION_TTL_DAYS=30
# CLI machine-token lifetime; computed from created_at, so lowering it revokes
# older tokens retroactively (default 90).
MACHINE_TOKEN_TTL_DAYS=90
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_MAX_REQUESTS=30

# --- Backend: build home (Depot, managed remote BuildKit — the sole build path) ---
DEPOT_PROJECT_ID=             # pin every build to one Depot project; empty resolves per app
# The App280Container harness Worker the generated roll config points `main` at,
# supplied by the runtime image (not the app source).
APP_WORKER_ENTRYPOINT=worker.js
# The per-app roll bakes the container-only serving topology into each app Worker:
# the central gateway service its GATEWAY binding targets (GatewayRPC mint/jwks),
# and the identity-token issuer its middleware verifies. Both default off the host
# suffix/app domain, so dev only needs APP_HOST_SUFFIX=-development set.
IDENTITY_GATEWAY_SERVICE=        # default 280-gateway<APP_HOST_SUFFIX>
# Backend IDENTITY_TOKEN_ISSUER (shared name with the gateway below): default
# https://auth<APP_HOST_SUFFIX>.<APP_BASE_DOMAIN>; must match what the gateway signs.

# --- Backend: blob store (Cloudflare R2 over its S3 API) ---
# Set these with the [SECRET] BLOB_S3_ACCESS_KEY_ID / BLOB_S3_SECRET_ACCESS_KEY
# above to use R2; leave all four empty for a local filesystem store (dev only).
BLOB_S3_ENDPOINT=            # e.g. https://<accountid>.r2.cloudflarestorage.com
BLOB_S3_BUCKET=
BLOB_S3_REGION=auto          # R2 uses "auto"
BLOB_S3_FORCE_PATH_STYLE=true
LOCAL_BLOB_DIRECTORY=data/blobs        # filesystem blob dir, used only when the S3 vars are unset

# --- Backend: HTTP + misc tunables ---
# Railway sets PORT; LISTEN_ADDRESS (host:port) is the local-loop fallback.
# PORT=8080
LISTEN_ADDRESS=:8080
# How often the cleanup sweep runs (expired sessions/device codes/rate windows/
# tokens, and deploys parked past the 30-minute waiting_secrets TTL). Keep it
# well under that TTL or parked deploys linger long past their expiry.
SWEEP_INTERVAL_SECONDS=60

# --- Gateway: edge front door (Cloudflare Worker) ---
# Shared with the backend above: DATABASE_SCHEMA, APP_BASE_DOMAIN,
# APP_HOST_SUFFIX, SESSION_COOKIE_DOMAIN, SESSION_TTL_DAYS,
# LOGIN_RATE_LIMIT_WINDOW_SECONDS, LOGIN_RATE_LIMIT_MAX_REQUESTS.
AUTH_HOST=                    # auth host; default auth.<APP_BASE_DOMAIN>
IDENTITY_TOKEN_ISSUER=             # signed-identity issuer; default https://<auth host>
IDENTITY_TOKEN_TTL_SECONDS=120     # injected identity token lifetime
IDENTITY_TOKEN_SIGNING_KID=k1      # key id in the identity JWT header
ENTRA_TENANT=organizations         # Entra tenant for Microsoft OIDC
FALLBACK_REDIRECT_URL=https://280apps.com  # redirect when no app target resolves
# Worker bindings (NOT plain env vars — declared in the gateway's wrangler config):
#   HYPERDRIVE     Hyperdrive binding to the control-plane Postgres.
#   APP_CONTAINER  Durable Object namespace of App280Container (one per app).
